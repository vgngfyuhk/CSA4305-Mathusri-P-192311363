<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Retail Website</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
        }

        header {
            background-color: #6a1b9a;
            color: white;
            padding: 20px;
            text-align: center;
        }

        nav {
            background-color: #4a148c;
            display: flex;
            justify-content: center;
            gap: 25px;
            padding: 15px;
            flex-wrap: wrap;
        }

        nav a {
            color: white;
            text-decoration: none;
            font-size: 17px;
        }

        .banner {
            background-color: #e1bee7;
            text-align: center;
            padding: 35px 15px;
        }

        .banner h2 {
            color: #4a148c;
            margin-bottom: 10px;
        }

        .product-container {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            padding: 30px;
        }

        .product {
            background-color: white;
            padding: 20px;
            text-align: center;
            border-radius: 10px;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
        }

        .product h3 {
            color: #6a1b9a;
            margin-bottom: 10px;
        }

        .product p {
            margin-bottom: 10px;
        }

        button {
            background-color: #6a1b9a;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 5px;
            cursor: pointer;
        }

        footer {
            background-color: #4a148c;
            color: white;
            text-align: center;
            padding: 18px;
        }

        @media screen and (max-width: 900px) {
            .product-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media screen and (max-width: 600px) {
            nav {
                flex-direction: column;
                align-items: center;
            }

            .product-container {
                grid-template-columns: 1fr;
                padding: 20px;
            }

            header h1 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>Smart Retail Store</h1>
        <p>Affordable and Quality Products</p>
    </header>

    <nav>
        <a href="#">Home</a>
        <a href="#">Products</a>
        <a href="#">Offers</a>
        <a href="#">Cart</a>
        <a href="#">Contact</a>
    </nav>

    <section class="banner">
        <h2>Welcome to Our Retail Store</h2>
        <p>Explore our latest products and special offers.</p>
    </section>

    <section class="product-container">

        <div class="product">
            <h3>Smartphone</h3>
            <p>Latest smartphone with advanced features.</p>
            <p><b>₹15,999</b></p>
            <button>Add to Cart</button>
        </div>

        <div class="product">
            <h3>Laptop</h3>
            <p>Powerful laptop for students and professionals.</p>
            <p><b>₹49,999</b></p>
            <button>Add to Cart</button>
        </div>

        <div class="product">
            <h3>Headphones</h3>
            <p>Wireless headphones with clear sound.</p>
            <p><b>₹1,999</b></p>
            <button>Add to Cart</button>
        </div>

        <div class="product">
            <h3>Smart Watch</h3>
            <p>Track fitness and daily activities.</p>
            <p><b>₹2,999</b></p>
            <button>Add to Cart</button>
        </div>

    </section>

    <footer>
        <p>© 2026 Smart Retail Store</p>
    </footer>

</body>
</html>
