<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Layout Debugging</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
        }

        header {
            background-color: #00695c;
            color: white;
            padding: 25px;
            text-align: center;
        }

        nav {
            background-color: #004d40;
            display: flex;
            justify-content: center;
            gap: 25px;
            padding: 15px;
            flex-wrap: wrap;
        }

        nav a {
            color: white;
            text-decoration: none;
        }

        .layout {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 20px;
            width: 90%;
            max-width: 1200px;
            margin: 30px auto;
        }

        aside {
            background-color: #b2dfdb;
            padding: 20px;
            border-radius: 10px;
        }

        aside h2 {
            color: #004d40;
            margin-bottom: 15px;
        }

        aside li {
            margin-bottom: 10px;
        }

        main {
            min-width: 0;
        }

        .content {
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .content h2 {
            color: #00695c;
            margin-bottom: 12px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-top: 20px;
        }

        .card {
            background-color: #e0f2f1;
            padding: 20px;
            border-left: 5px solid #00897b;
            border-radius: 8px;
        }

        .card h3 {
            color: #004d40;
            margin-bottom: 10px;
        }

        footer {
            background-color: #004d40;
            color: white;
            padding: 20px;
            text-align: center;
        }

        @media screen and (max-width: 900px) {
            .layout {
                grid-template-columns: 200px 1fr;
            }

            .cards {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media screen and (max-width: 650px) {
            .layout {
                grid-template-columns: 1fr;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            nav {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>Responsive Information Portal</h1>
        <p>CSS Layout Debugging Example</p>
    </header>

    <nav>
        <a href="#">Home</a>
        <a href="#">Services</a>
        <a href="#">Resources</a>
        <a href="#">About</a>
        <a href="#">Contact</a>
    </nav>

    <div class="layout">

        <aside>
            <h2>Categories</h2>

            <ul>
                <li>HTML</li>
                <li>CSS</li>
                <li>JavaScript</li>
                <li>Flexbox</li>
                <li>CSS Grid</li>
            </ul>
        </aside>

        <main>

            <section class="content">

                <h2>Corrected Responsive Layout</h2>

                <p>
                    This webpage uses CSS Grid and media queries
                    to prevent overlapping during browser resizing.
                </p>

                <div class="cards">

                    <div class="card">
                        <h3>Box Model</h3>
                        <p>
                            Border-box prevents padding and borders
                            from increasing the total width.
                        </p>
                    </div>

                    <div class="card">
                        <h3>Flexbox</h3>
                        <p>
                            Flexbox aligns navigation items and
                            allows them to wrap.
                        </p>
                    </div>

                    <div class="card">
                        <h3>CSS Grid</h3>
                        <p>
                            Grid creates responsive rows and columns
                            without overlapping.
                        </p>
                    </div>

                </div>

            </section>

            <section class="content">
                <h2>Layout Testing</h2>

                <p>
                    Resize the browser window to observe how the
                    sidebar, content, cards, and navigation adjust.
                </p>
            </section>

        </main>

    </div>

    <footer>
        <p>© 2026 Responsive Information Portal</p>
    </footer>

</body>
</html>
