</style>

<script>

var cart=[];
var total=0;


/* Login */

function login(){

    var email=document.getElementById("email").value;
    var password=document.getElementById("password").value;

    if(email=="" || password==""){
        alert("Please enter email and password");
    }
    else{
        alert("Login Successful!");
    }
}


/* Registration */

function register(){

    var name=document.getElementById("name").value;

    if(name==""){
        alert("Please enter your name");
    }
    else{
        alert("Registration Successful!");
    }
}


/* Search */

function searchProduct(){

    var search=
    document.getElementById("search").value.toLowerCase();

    var products=
    document.getElementsByClassName("product");

    for(var i=0;i<products.length;i++){

        var text=
        products[i].innerText.toLowerCase();

        if(text.includes(search)){
            products[i].style.display="block";
        }
        else{
            products[i].style.display="none";
        }
    }
}


/* Add Cart */

function addCart(name,price){

    cart.push({
        name:name,
        price:price
    });

    total+=price;

    showCart();

    alert(name+" added to cart");
}


/* Show Cart */

function showCart(){

    var list=
    document.getElementById("cartList");

    list.innerHTML="";

    if(cart.length==0){

        list.innerHTML=
        "<p>Your cart is empty.</p>";

    }

    for(var i=0;i<cart.length;i++){

        list.innerHTML+=
        "<div class='cart-item'>"+
        "<span>"+cart[i].name+
        " - ₹"+cart[i].price+"</span>"+
        "<button onclick='removeCart("+i+")'>Remove</button>"+
        "</div>";
    }

    document.getElementById("total").innerHTML=
    "Total: ₹"+total;
}


/* Remove Cart */

function removeCart(index){

    total-=cart[index].price;

    cart.splice(index,1);

    showCart();
}


/* Checkout */

function checkout(){

    if(cart.length==0){

        alert("Your cart is empty");

        return;
    }

    var order=
    "BG"+Math.floor(100000+Math.random()*900000);

    document.getElementById("orderId").innerHTML=order;

    alert(
        "Order placed successfully!\n"+
        "Order ID: "+order+
        "\nTotal: ₹"+total
    );
}


/* Payment */

function payment(){

    if(total==0){

        alert("Add products before payment");

    }
    else{

        alert(
            "Payment Successful!\n"+
            "Amount Paid: ₹"+total
        );

    }
}


/* Product Details */

function details(name){

    alert(
        name+
        "\n\nFresh and beautifully arranged gift."+
        "\nAvailable for delivery."
    );
}


/* Wishlist */

function wishlist(name){

    alert(name+" added to wishlist ❤️");

}


/* Schedule Delivery */

function schedule(){

    var date=
    document.getElementById("deliveryDate").value;

    var time=
    document.getElementById("deliveryTime").value;

    if(date=="" || time==""){

        alert("Select delivery date and time");

    }
    else{

        alert(
            "Delivery scheduled successfully!\n"+
            "Date: "+date+
            "\nTime: "+time
        );

    }
}


/* Order Status */

function orderStatus(){

    var id=
    document.getElementById("orderSearch").value;

    if(id==""){

        alert("Enter Order ID");

    }
    else{

        document.getElementById("status").innerHTML=
        "Order "+id+" : Out for Delivery";

    }
}


/* Customer Information */

function updateCustomer(){

    alert(
        "Customer information updated successfully!"
    );

}


/* Admin Add Product */

function addProduct(){

    var name=
    document.getElementById("newProduct").value;

    var price=
    document.getElementById("newPrice").value;

    if(name=="" || price==""){

        alert("Enter product details");

    }
    else{

        alert(
            "Product added successfully!\n"+
            name+" - ₹"+price
        );

    }
}


/* Admin Update */

function updateProduct(){

    alert("Product details updated successfully!");

}


/* Admin Delete */

function deleteProduct(){

    alert("Product deleted successfully!");

}


/* Email */

function emailSupport(){

    alert(
        "Email enquiry sent successfully!"
    );

}


/* Logout */

function logout(){

    alert("Logged out successfully!");

}

</script>

