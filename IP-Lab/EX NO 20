<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#fff7fa;
    color:#333;
}

header{
    background:#c2185b;
    color:white;
    text-align:center;
    padding:25px;
}

header h1{
    font-size:32px;
}

nav{
    background:#7b123b;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
}

nav a{
    color:white;
    text-decoration:none;
    padding:14px 18px;
}

nav a:hover{
    background:#c2185b;
}

.hero{
    background:#ffe1ec;
    text-align:center;
    padding:50px 20px;
}

.hero h2{
    color:#c2185b;
    font-size:30px;
    margin-bottom:10px;
}

.container{
    width:90%;
    max-width:1150px;
    margin:auto;
}

section{
    background:white;
    margin:22px 0;
    padding:22px;
    border-radius:10px;
    box-shadow:0 2px 8px #ddd;
}

h2{
    color:#c2185b;
    margin-bottom:15px;
}

h3{
    color:#7b123b;
    margin:10px 0;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

input,select,textarea{
    width:100%;
    padding:11px;
    margin:5px 0 12px;
    border:1px solid #ccc;
    border-radius:5px;
}

button{
    background:#c2185b;
    color:white;
    border:0;
    padding:11px 18px;
    border-radius:5px;
    cursor:pointer;
    margin:3px;
}

button:hover{
    background:#7b123b;
}

.categories{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.category{
    background:#fff0f5;
    padding:20px;
    text-align:center;
    border-radius:8px;
}

.products{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.product{
    border:1px solid #ddd;
    border-radius:8px;
    padding:15px;
    text-align:center;
}

.product img{
    width:100%;
    height:190px;
    object-fit:cover;
    border-radius:7px;
}

.price{
    color:#c2185b;
    font-size:20px;
    font-weight:bold;
    margin:10px;
}

.badge{
    display:inline-block;
    background:#ffe1ec;
    color:#c2185b;
    padding:5px 10px;
    border-radius:15px;
    margin:3px;
    font-size:12px;
}

.cart-item{
    display:flex;
    justify-content:space-between;
    padding:12px;
    border-bottom:1px solid #ddd;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    border:1px solid #ccc;
    padding:10px;
    text-align:center;
}

th{
    background:#c2185b;
    color:white;
}

footer{
    background:#7b123b;
    color:white;
    text-align:center;
    padding:20px;
}

@media(max-width:800px){

    .form-grid{
        grid-template-columns:1fr;
    }

    .categories{
