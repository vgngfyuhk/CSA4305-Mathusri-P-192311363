<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Online Flight Reservation System</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

html{
    scroll-behavior:smooth;
}

body{
    background:#f4f7fb;
    color:#222;
}

/* Header */
header{
    background:#12355b;
    color:white;
    padding:22px;
    text-align:center;
}

header h1{
    margin-bottom:6px;
}

/* Navigation */
nav{
    background:#0b243f;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
}

nav a{
    color:white;
    text-decoration:none;
    padding:14px 18px;
}

nav a:hover{
    background:#1d5d91;
}

/* Hero */
.hero{
    background:linear-gradient(120deg,#dceeff,#ffffff);
    text-align:center;
    padding:55px 20px;
}

.hero h2{
    color:#12355b;
    font-size:32px;
    margin-bottom:10px;
}

/* Container */
.container{
    width:90%;
    max-width:1100px;
    margin:auto;
}

/* Sections */
section{
    background:white;
    margin:25px 0;
    padding:25px;
    border-radius:10px;
    box-shadow:0 2px 10px #ddd;
}

h2{
    color:#12355b;
    margin-bottom:18px;
}

/* Forms */
.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

input,select,textarea{
    width:100%;
    padding:11px;
    margin-top:6px;
    border:1px solid #bbb;
    border-radius:5px;
}

textarea{
    height:100px;
    resize:none;
}

button{
    background:#1261a0;
    color:white;
    border:0;
    padding:12px 18px;
    border-radius:5px;
    cursor:pointer;
    margin-top:10px;
}

button:hover{
    background:#0b3d66;
}

.full{
    width:100%;
}

/* Flight Cards */
.flight-list{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.flight-card{
    border:1px solid #ddd;
    padding:18px;
    border-radius:8px;
}

.flight-card h3{
    color:#1261a0;
    margin-bottom:10px;
}

.flight-card p{
    margin:7px 0;
}

/* Tables */
table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    border:1px solid #ccc;
    padding:11px;
    text-align:center;
}

th{
    background:#12355b;
    color:white;
}

/* Message */
.message{
    margin-top:15px;
    font-weight:bold;
}

/* Footer */
footer{
    background:#0b243f;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:30px;
}

/* Responsive */
@media(max-width:800px){

    .form-grid{
        grid-template-columns:1fr;
    }

    .flight-list{
        grid-template-columns:1fr;
    }

}

@media(max-width:600px){

    nav{
        flex-direction:column;
        text-align:center;
    }

    nav a{
        padding:10px;
    }

    .hero h2{
        font-size:25px;
    }

    section{
        padding:18px;
    }

    table{
        font-size:12px;
    }
}
</style>

<script>

/* Login */
function login(){

    var user=document.getElementById("username").value;
    var pass=document.getElementById("password").value;

    if(user=="" || pass==""){
        alert("Please enter username and password");
    }
    else{
        alert("Administrator Login Successful!");
    }
}


/* Forgot Password */
function forgotPassword(){

    var email=document.getElementById("forgotEmail").value;

    if(email==""){
        alert("Enter your registered email");
    }
    else{
        alert("Password reset link sent to " + email);
    }
}


/* Search Flight */
function searchFlight(){

    var from=document.getElementById("from").value;
    var to=document.getElementById("to").value;
    var date=document.getElementById("travelDate").value;

    if(from=="" || to=="" || date==""){
        alert("Please enter source, destination and date");
        return;
    }

    document.getElementById("searchMessage").innerHTML =
    "Flights found from " + from + " to " + to +
    " on " + date;
}


/* Book Ticket */
function bookTicket(){

    var name=document.getElementById("passenger").value;
    var flight=document.getElementById("flight").value;
    var seat=document.getElementById("seat").value;

    if(name=="" || seat==""){
        alert("Please enter passenger name and seat");
        return;
    }

    var pnr="FL"+Math.floor(100000+Math.random()*900000);

    document.getElementById("pnrValue").innerHTML=pnr;
    document.getElementById("ticketName").innerHTML=name;
    document.getElementById("ticketFlight").innerHTML=flight;
    document.getElementById("ticketSeat").innerHTML=seat;

    alert("Ticket booked successfully!\nPNR: " + pnr);

    document.getElementById("ticket").style.display="block";
}


/* Payment */
function payment(){

    var card=document.getElementById("card").value;
    var amount=document.getElementById("amount").value;

    if(card=="" || amount==""){
        alert("Enter payment details");
        return;
    }

    alert("Payment of ₹"+amount+" successful!");
}


/* PNR Status */
function checkPNR(){

    var pnr=document.getElementById("checkPnr").value;

    if(pnr==""){
        alert("Enter PNR number");
    }
    else{
        document.getElementById("pnrStatus").innerHTML =
        "PNR " + pnr + " : CONFIRMED";
    }
}


/* Cancel Ticket */
function cancelTicket(){

    var pnr=document.getElementById("cancelPnr").value;

    if(pnr==""){
        alert("Enter PNR number");
    }
    else{
        alert("Ticket " + pnr +
        " cancelled successfully.\nRefund will be processed.");
    }
}


/* Print Ticket */
function printTicket(){

    window.print();

}


/* Feedback */
function feedback(){

    var name=document.getElementById("feedbackName").value;
    var msg=document.getElementById("feedbackText").value;

    if(name=="" || msg==""){
        alert("Please enter your name and feedback");
    }
    else{
        alert("Thank you " + name +
        " for your valuable feedback!");
    }
}


/* Admin Report */
function report(){

    document.getElementById("reportResult").innerHTML =
    "Total Flights: 25 | Bookings: 150 | Available Seats: 320";
}

</script>

</head>

<body>

<!-- Header -->

<header>

<h1>✈ Online Flight Reservation System</h1>

<p>Search • Book • Manage Your Journey</p>

</header>


<!-- Navigation -->

<nav>

<a href="#home">Home</a>

<a href="#login">Admin Login</a>

<a href="#search">Search Flight</a>

<a href="#booking">Book Ticket</a>

<a href="#payment">Payment</a>

<a href="#ticket">My Ticket</a>

<a href="#status">PNR Status</a>

<a href="#cancel">Cancel</a>

<a href="#feedback">Feedback</a>

</nav>


<!-- Hero -->

<div class="hero" id="home">

<h2>Book Your Flight Easily</h2>

<p>Search flights, select your seat and manage your tickets online.</p>

</div>


<div class="container">


<!-- Admin Login -->

<section id="login">

<h2>Administrator Login</h2>

<div class="form-grid">

<div>
<label>Username</label>
<input type="text" id="username" placeholder="Enter username">
</div>

<div>
<label>Password</label>
<input type="password" id="password" placeholder="Enter password">
</div>

</div>

<button onclick="login()">Login</button>

</section>


<!-- Forgot Password -->

<section>

<h2>Forgot Password</h2>

<input type="email"
id="forgotEmail"
placeholder="Enter registered email">

<button onclick="forgotPassword()">Reset Password</button>

</section>


<!-- Search Flight -->

<section id="search">

<h2>Search Flight</h2>

<div class="form-grid">

<div>
<label>From</label>
<input type="text"
id="from"
placeholder="Chennai">
</div>

<div>
<label>To</label>
<input type="text"
id="to"
placeholder="Mumbai">
</div>

<div>
<label>Travel Date</label>
<input type="date" id="travelDate">
</div>

<div>
<label>Class</label>

<select>
<option>Economy</option>
<option>Premium Economy</option>
<option>Business</option>
<option>First Class</option>
</select>

</div>

</div>

<button class="full"
onclick="searchFlight()">Search Flights</button>

<p class="message" id="searchMessage"></p>

</section>


<!-- Available Flights -->

<section>

<h2>Available Flights</h2>

<div class="flight-list">

<div class="flight-card">

<h3>AI 101</h3>

<p>Chennai → Mumbai</p>

<p>Departure: 08:00 AM</p>

<p>Arrival: 10:00 AM</p>

<p>Seats Available: 24</p>

<p>Fare: ₹5,500</p>

</div>


<div class="flight-card">

<h3>6E 205</h3>

<p>Chennai → Delhi</p>

<p>Departure: 11:30 AM</p>

<p>Arrival: 02:30 PM</p>

<p>Seats Available: 18</p>

<p>Fare: ₹6,200</p>

</div>


<div class="flight-card">

<h3>SG 310</h3>

<p>Chennai → Bangalore</p>

<p>Departure: 04:00 PM</p>

<p>Arrival: 05:00 PM</p>

<p>Seats Available: 32</p>

<p>Fare: ₹3,500</p>

</div>

</div>

</section>


<!-- Book Ticket -->

<section id="booking">

<h2>Book Ticket</h2>

<div class="form-grid">

<div>

<label>Passenger Name</label>

<input type="text"
id="passenger"
placeholder="Enter passenger name">

</div>


<div>

<label>Select Flight</label>

<select id="flight">

<option>AI 101 - Chennai to Mumbai</option>

<option>6E 205 - Chennai to Delhi</option>

<option>SG 310 - Chennai to Bangalore</option>

</select>

</div>


<div>

<label>Seat Number</label>

<select id="seat">

<option>12A</option>
<option>12B</option>
<option>13A</option>
<option>13B</option>
<option>14A</option>

</select>

</div>


<div>

<label>Passenger Age</label>

<input type="number"
placeholder="Enter age">

</div>

</div>

<button onclick="bookTicket()">Book Ticket</button>

</section>


<!-- Payment -->

<section id="payment">

<h2>Ticket Payment</h2>

<div class="form-grid">

<div>

<label>Card / UPI Number</label>

<input type="text"
id="card"
placeholder="Enter payment details">

</div>


<div>

<label>Ticket Amount</label>

<input type="number"
id="amount"
placeholder="Enter amount">

</div>

</div>

<button onclick="payment()">Make Payment</button>

</section>


<!-- My Ticket -->

<section id="ticket">

<h2>My Ticket</h2>

<table>

<tr>
<th>PNR</th>
<td id="pnrValue">---</td>
</tr>

<tr>
<th>Passenger</th>
<td id="ticketName">---</td>
</tr>

<tr>
<th>Flight</th>
<td id="ticketFlight">---</td>
</tr>

<tr>
<th>Seat</th>
<td id="ticketSeat">---</td>
</tr>

<tr>
<th>Status</th>
<td>CONFIRMED</td>
</tr>

</table>

<button onclick="printTicket()">Print Ticket</button>

</section>


<!-- PNR Status -->

<section id="status">

<h2>View Booking Status</h2>

<input type="text"
id="checkPnr"
placeholder="Enter PNR number">

<button onclick="checkPNR()">Check Status</button>

<p class="message" id="pnrStatus"></p>

</section>


<!-- Cancel Ticket -->

<section id="cancel">

<h2>Cancel Ticket</h2>

<input type="text"
id="cancelPnr"
placeholder="Enter PNR number">

<button onclick="cancelTicket()">Cancel Ticket</button>

</section>


<!-- Booking History -->

<section>

<h2>My Booking History</h2>

<table>

<tr>

<th>PNR</th>

<th>Flight</th>

<th>Route</th>

<th>Status</th>

</tr>


<tr>

<td>FL123456</td>

<td>AI 101</td>

<td>Chennai - Mumbai</td>

<td>Confirmed</td>

</tr>


<tr>

<td>FL456789</td>

<td>6E 205</td>

<td>Chennai - Delhi</td>

<td>Completed</td>

</tr>

</table>

</section>


<!-- Customer Feedback -->

<section id="feedback">

<h2>Customer Feedback</h2>

<input type="text"
id="feedbackName"
placeholder="Your Name">

<textarea
id="feedbackText"
placeholder="Write your feedback"></textarea>

<button onclick="feedback()">Submit Feedback</button>

</section>


<!-- Admin Report -->

<section>

<h2>Admin Report</h2>

<button onclick="report()">Generate Report</button>

<p class="message"
id="reportResult"></p>

</section>


</div>


<!-- Footer -->

<footer>

<p>© 2026 Online Flight Reservation System</p>

<p>Safe • Fast • Convenient</p>

</footer>


</body>
</html>
