</tr>

</table>

</section>


<!-- PAYMENT -->

<section id="payment">

<h2>💳 Premium Payment</h2>

<input type="text"
placeholder="Policy Number">

<input type="number"
id="paymentAmount"
placeholder="Premium Amount">

<select>

<option>UPI</option>
<option>Credit Card</option>
<option>Debit Card</option>
<option>Net Banking</option>

</select>

<button onclick="payPremium()">
Pay Premium
</button>

</section>


<!-- CLAIM -->

<section id="claims">

<h2>📝 File Insurance Claim</h2>

<input type="text"
id="claimPolicy"
placeholder="Policy Number">

<select>

<option>Medical Claim</option>
<option>Vehicle Accident</option>
<option>Property Damage</option>

</select>

<textarea
placeholder="Describe your claim">
</textarea>

<button onclick="fileClaim()">
Submit Claim
</button>

</section>


<!-- SMS -->

<section>

<h2>📱 Send SMS Alert</h2>

<input type="text"
id="smsCustomer"
placeholder="Customer Name">

<select>

<option>Premium Due Reminder</option>
<option>Policy Renewal Reminder</option>
<option>Payment Confirmation</option>

</select>

