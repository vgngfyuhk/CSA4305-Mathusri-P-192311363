<a href="#policies">Policies</a>
<a href="#payment">Payment</a>
<a href="#claims">Claims</a>
<a href="#agent">Agent</a>
<a href="#admin">Admin</a>
<a href="#login" onclick="logout()">Logout</a>

</nav>


