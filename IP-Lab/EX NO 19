<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>InsureEasy - Insurance Management</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f3f8ff;
    color:#333;
}

header{
    background:#1769aa;
    color:white;
    text-align:center;
    padding:25px;
}

header h1{
    font-size:32px;
}

nav{
    background:#0d4775;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
}

nav a{
    color:white;
    text-decoration:none;
    padding:14px 18px;
}

nav a:hover{
    background:#1769aa;
}

.hero{
    background:#dceeff;
    text-align:center;
    padding:50px 20px;
}

.hero h2{
    color:#1769aa;
    font-size:30px;
    margin-bottom:10px;
}

.container{
    width:90%;
    max-width:1150px;
    margin:auto;
}

section{
    background:white;
    margin:22px 0;
    padding:22px;
    border-radius:10px;
    box-shadow:0 2px 8px #ddd;
}

h2{
    color:#1769aa;
    margin-bottom:15px;
}

h3{
    color:#0d4775;
    margin:12px 0;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

input,select,textarea{
    width:100%;
    padding:11px;
    margin:5px 0 12px;
    border:1px solid #ccc;
    border-radius:5px;
}

textarea{
    resize:vertical;
}

button{
    background:#1769aa;
    color:white;
    border:0;
    padding:11px 18px;
    border-radius:5px;
    cursor:pointer;
    margin:3px;
}

button:hover{
    background:#0d4775;
}

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.card{
    border:1px solid #ddd;
    border-radius:8px;
    padding:20px;
    text-align:center;
    background:#f9fcff;
}

.icon{
    font-size:40px;
}

.price{
    color:#1769aa;
    font-size:20px;
    font-weight:bold;
    margin:10px;
}

.badge{
    display:inline-block;
    background:#dceeff;
    color:#1769aa;
    padding:5px 10px;
    border-radius:15px;
    margin:3px;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    border:1px solid #ccc;
    padding:10px;
    text-align:center;
}

th{
    background:#1769aa;
    color:white;
}

.success{
    color:green;
    font-weight:bold;
}

.warning{
    color:#d17b00;
    font-weight:bold;
}

footer{
    background:#0d4775;
    color:white;
    text-align:center;
    padding:20px;
}

@media(max-width:800px){

    .form-grid{
        grid-template-columns:1fr;
    }

    .cards{
        grid-template-columns:1fr 1fr;
    }

}

@media(max-width:600px){

    nav{
        flex-direction:column;
        text-align:center;
    }

    .cards{
        grid-template-columns:1fr;
    }

    table{
        font-size:12px;
    }

    .hero h2{
        font-size:24px;
    }

}

</style>

<script>

var policies=[];


/* User Login */

function userLogin(){

    var email=
    document.getElementById("userEmail").value;

    var password=
    document.getElementById("userPassword").value;

    if(email=="" || password==""){

        alert("Please enter email and password");

    }
    else{

        alert("User Login Successful!");

    }

}


/* Agent Registration */

function agentRegister(){

    var name=
    document.getElementById("agentName").value;

    var email=
    document.getElementById("agentEmail").value;

    if(name=="" || email==""){

        alert("Please enter agent details");

    }
    else{

        alert(
            "Agent registration submitted.\n"+
            "Waiting for Admin approval."
        );

    }

}


/* Agent Login */

function agentLogin(){

    var email=
    document.getElementById("agentLoginEmail").value;

    var password=
    document.getElementById("agentLoginPassword").value;

    if(email=="" || password==""){

        alert("Enter agent login details");

    }
    else{

        alert("Agent Login Successful!");

    }

}


/* Admin Login */

function adminLogin(){

    var username=
    document.getElementById("adminUser").value;

    var password=
    document.getElementById("adminPassword").value;

    if(username=="" || password==""){

        alert("Enter admin credentials");

    }
    else{

        alert("Admin Login Successful!");

    }

}


/* Create Customer */

function createCustomer(){

    var name=
    document.getElementById("customerName").value;

    var phone=
    document.getElementById("customerPhone").value;

    if(name=="" || phone==""){

        alert("Enter customer details");

    }
    else{

        alert(
            "Customer created successfully!\n"+
            "Name: "+name
        );

    }

}


/* Add Policy */

function addPolicy(){

    var customer=
    document.getElementById("policyCustomer").value;

    var type=
    document.getElementById("policyType").value;

    var amount=
    document.getElementById("policyAmount").value;

    var due=
    document.getElementById("dueDate").value;

    if(customer=="" ||
       amount=="" ||
       due==""){

        alert("Please fill all policy details");

        return;

    }

    policies.push({
        customer:customer,
        type:type,
        amount:amount,
        due:due
    });

    alert(
        "Policy added successfully!\n"+
        "Customer: "+customer+
        "\nPolicy: "+type
    );

}


/* Compare Policies */

function comparePolicies(){

    var type=
    document.getElementById("compareType").value;

    document.getElementById("comparison").innerHTML=

    "<h3>Policy Comparison</h3>"+
    "<p><b>Selected:</b> "+type+"</p>"+
    "<table>"+
    "<tr>"+
    "<th>Plan</th>"+
    "<th>Coverage</th>"+
    "<th>Premium</th>"+
    "</tr>"+
    "<tr>"+
    "<td>Basic</td>"+
    "<td>₹5 Lakhs</td>"+
    "<td>₹8,000/year</td>"+
    "</tr>"+
    "<tr>"+
    "<td>Premium</td>"+
    "<td>₹15 Lakhs</td>"+
    "<td>₹18,000/year</td>"+
    "</tr>"+
    "</table>";

}


/* Premium Payment */

function payPremium(){

    var amount=
    document.getElementById("paymentAmount").value;

    if(amount==""){

        alert("Enter premium amount");

    }
    else{

        alert(
            "Payment Successful!\n"+
            "Premium Paid: ₹"+amount
        );

    }

}


/* SMS Alert */

function sendSMS(){

    var customer=
    document.getElementById("smsCustomer").value;

    if(customer==""){

        alert("Enter customer name");

    }
    else{

        alert(
            "SMS Alert Sent Successfully!\n"+
            "Customer: "+customer
        );

    }

}


/* Claim */

function fileClaim(){

    var policy=
    document.getElementById("claimPolicy").value;

    if(policy==""){

        alert("Enter policy number");

    }
    else{

        alert(
            "Claim submitted successfully!\n"+
            "Policy No: "+policy
        );

    }

}


/* Logout */

function logout(){

    alert("Logged out successfully!");

}

</script>

</head>

<body>


