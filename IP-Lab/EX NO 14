<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Beauty Parlour Appointment</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial;
}

body{
    background:#fff5f8;
    color:#333;
}

header{
    background:#b83280;
    color:white;
    text-align:center;
    padding:25px;
}

nav{
    background:#7b1b52;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
}

nav a{
    color:white;
    text-decoration:none;
    padding:14px 18px;
}

nav a:hover{
    background:#b83280;
}

.hero{
    text-align:center;
    padding:50px 20px;
    background:#ffe3ef;
}

.hero h2{
    color:#b83280;
    margin-bottom:10px;
}

.container{
    width:90%;
    max-width:1100px;
    margin:auto;
}

section{
    background:white;
    margin:22px 0;
    padding:22px;
    border-radius:10px;
    box-shadow:0 2px 8px #ddd;
}

h2{
    color:#b83280;
    margin-bottom:15px;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

input,select,textarea{
    width:100%;
    padding:10px;
    margin-top:5px;
    margin-bottom:12px;
    border:1px solid #ccc;
    border-radius:5px;
}

textarea{
    height:80px;
}

button{
    background:#b83280;
    color:white;
    border:0;
    padding:11px 18px;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:#7b1b52;
}

.services{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.service{
    border:1px solid #ddd;
    padding:18px;
    border-radius:8px;
    text-align:center;
}

.service h3{
    color:#b83280;
    margin-bottom:10px;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    border:1px solid #ccc;
    padding:10px;
    text-align:center;
}

th{
    background:#b83280;
    color:white;
}

footer{
    background:#7b1b52;
    color:white;
    text-align:center;
    padding:18px;
    margin-top:20px;
}

@media(max-width:800px){

    .form-grid{
        grid-template-columns:1fr;
    }

    .services{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){

    nav{
        flex-direction:column;
        text-align:center;
    }

    .services{
        grid-template-columns:1fr;
    }

    table{
        font-size:12px;
    }
}
</style>

<script>

function login(){

    var user=document.getElementById("username").value;
    var pass=document.getElementById("password").value;

    if(user=="" || pass=="")
        alert("Please enter username and password");
    else
        alert("Login Successful!");
}


function register(){

    var name=document.getElementById("regname").value;

    if(name=="")
        alert("Please enter your name");
    else
        alert("Registration Successful!");
}


function bookAppointment(){

    var name=document.getElementById("customer").value;
    var service=document.getElementById("service").value;
    var stylist=document.getElementById("stylist").value;
    var date=document.getElementById("date").value;
    var time=document.getElementById("time").value;

    if(name=="" || date=="" || time==""){
        alert("Please fill all appointment details");
        return;
    }

    var id="AP"+Math.floor(100000+Math.random()*900000);

    document.getElementById("appointmentId").innerHTML=id;
    document.getElementById("appointmentName").innerHTML=name;
    document.getElementById("appointmentService").innerHTML=service;
    document.getElementById("appointmentStylist").innerHTML=stylist;
    document.getElementById("appointmentDate").innerHTML=date;
    document.getElementById("appointmentTime").innerHTML=time;

    alert("Appointment booked successfully!\nAppointment ID: "+id);
}


function payment(){

    var amount=document.getElementById("amount").value;

    if(amount=="")
        alert("Enter payment amount");
    else
        alert("Payment of ₹"+amount+" successful!");
}


function cancelAppointment(){

    var id=document.getElementById("cancelId").value;

    if(id=="")
        alert("Enter appointment ID");
    else
        alert("Appointment "+id+
        " cancelled successfully.");
}


function feedback(){

    var name=document.getElementById("feedbackName").value;
    var msg=document.getElementById("feedback").value;

    if(name=="" || msg=="")
        alert("Please enter your feedback");
    else
        alert("Thank you "+name+" for your feedback!");
}


function adminLogin(){
    alert("Salon Manager Login Successful!");
}


function updateAppointment(){
    alert("Appointment status updated successfully!");
}

</script>

</head>

<body>

<header>

<h1>💇 Beauty Parlour Appointment System</h1>

<p>Book Your Beauty Appointment Easily</p>

</header>


<nav>

<a href="#home">Home</a>
<a href="#login">Login</a>
<a href="#services">Services</a>
<a href="#booking">Book Appointment</a>
<a href="#calendar">Calendar</a>
<a href="#account">My Account</a>
<a href="#admin">Admin</a>
<a href="#feedbackSection">Feedback</a>

</nav>


<div class="hero" id="home">

<h2>Look Beautiful, Feel Beautiful</h2>

<p>Choose your service, stylist and preferred appointment time.</p>

</div>


<div class="container">


<!-- Login -->

<section id="login">

<h2>Customer Login</h2>

<div class="form-grid">

<div>
<label>Username</label>
<input type="text" id="username"
placeholder="Enter username">
</div>

<div>
<label>Password</label>
<input type="password" id="password"
placeholder="Enter password">
</div>

</div>

<button onclick="login()">Login</button>

</section>


<!-- Registration -->

<section>

<h2>Customer Registration</h2>

<input type="text" id="regname"
placeholder="Enter your name">

<input type="email"
placeholder="Enter email">

<input type="password"
placeholder="Create password">

<button onclick="register()">Register</button>

</section>


<!-- Services -->

<section id="services">

<h2>Our Services</h2>

<div class="services">

<div class="service">

<h3>Hair Styling</h3>

<p>Professional hair styling</p>

<p><b>₹500</b></p>

</div>


<div class="service">

<h3>Facial</h3>

<p>Skin care and facial treatment</p>

<p><b>₹800</b></p>

</div>


<div class="service">

<h3>Makeup</h3>

<p>Party and bridal makeup</p>

<p><b>₹1500</b></p>

</div>


<div class="service">

<h3>Manicure</h3>

<p>Professional nail care</p>

<p><b>₹400</b></p>

</div>


<div class="service">

<h3>Pedicure</h3>

<p>Relaxing foot treatment</p>

<p><b>₹500</b></p>

</div>


<div class="service">

<h3>Hair Spa</h3>

<p>Complete hair treatment</p>

<p><b>₹1000</b></p>

</div>

</div>

</section>


<!-- Appointment -->

<section id="booking">

<h2>Book Appointment</h2>

<div class="form-grid">

<div>

<label>Customer Name</label>

<input type="text"
id="customer"
placeholder="Enter name">

</div>


<div>

<label>Service</label>

<select id="service">

<option>Hair Styling</option>
<option>Facial</option>
<option>Makeup</option>
<option>Manicure</option>
<option>Pedicure</option>
<option>Hair Spa</option>

</select>

</div>


<div>

<label>Stylist</label>

<select id="stylist">

<option>Priya</option>
<option>Divya</option>
<option>Meena</option>

</select>

</div>


<div>

<label>Appointment Date</label>

<input type="date" id="date">

</div>


<div>

<label>Appointment Time</label>

<select id="time">

<option>10:00 AM</option>
<option>11:00 AM</option>
<option>12:00 PM</option>
<option>02:00 PM</option>
<option>03:00 PM</option>
<option>04:00 PM</option>
<option>05:00 PM</option>

</select>

</div>

</div>

<button onclick="bookAppointment()">
Book Appointment
</button>

</section>


<!-- Calendar -->

<section id="calendar">

<h2>Reservations Calendar</h2>

<table>

<tr>
<th>Date</th>
<th>Time</th>
<th>Stylist</th>
<th>Status</th>
</tr>

<tr>
<td>20-08-2026</td>
<td>10:00 AM</td>
<td>Priya</td>
<td>Available</td>
</tr>

<tr>
<td>20-08-2026</td>
<td>11:00 AM</td>
<td>Divya</td>
<td>Booked</td>
</tr>

<tr>
<td>20-08-2026</td>
<td>02:00 PM</td>
<td>Meena</td>
<td>Available</td>
</tr>

</table>

</section>


<!-- My Account -->

<section id="account">

<h2>My Account</h2>

<table>

<tr>
<th>Appointment ID</th>
<th>Service</th>
<th>Date</th>
<th>Status</th>
</tr>

<tr>
<td id="appointmentId">AP123456</td>
<td id="appointmentService">Facial</td>
<td id="appointmentDate">20-08-2026</td>
<td>Confirmed</td>
</tr>

</table>

<h3>Upcoming Reservation</h3>

<p>Customer: <span id="appointmentName">Customer</span></p>

<p>Stylist: <span id="appointmentStylist">Priya</span></p>

<p>Time: <span id="appointmentTime">10:00 AM</span></p>

</section>


<!-- Payment -->

<section>

<h2>Online Payment</h2>

<select>

<option>Full Payment</option>
<option>Partial Deposit</option>

</select>

<input type="text"
placeholder="Card / UPI details">

<input type="number"
id="amount"
placeholder="Enter amount">

<button onclick="payment()">Make Payment</button>

</section>


<!-- Cancel -->

<section>

<h2>Cancel Appointment</h2>

<input type="text"
id="cancelId"
placeholder="Enter Appointment ID">

<button onclick="cancelAppointment()">
Cancel Appointment
</button>

</section>


<!-- Admin -->

<section id="admin">

<h2>Salon Manager / Staff Panel</h2>

<button onclick="adminLogin()">Manager Login</button>

<h3>Upcoming Reservations</h3>

<table>

<tr>
<th>ID</th>
<th>Customer</th>
<th>Service</th>
<th>Date</th>
<th>Status</th>
</tr>

<tr>
<td>AP123456</td>
<td>Customer 1</td>
<td>Facial</td>
<td>20-08-2026</td>
<td>Confirmed</td>
</tr>

<tr>
<td>AP123457</td>
<td>Customer 2</td>
<td>Hair Spa</td>
<td>21-08-2026</td>
<td>Pending</td>
</tr>

</table>

<br>

<button onclick="updateAppointment()">
Update Reservation
</button>

</section>


<!-- Feedback -->

<section id="feedbackSection">

<h2>Customer Feedback</h2>

<input type="text"
id="feedbackName"
placeholder="Your Name">

<textarea id="feedback"
placeholder="Share your experience"></textarea>

<button onclick="feedback()">
Submit Feedback
</button>

</section>


</div>


<footer>

<p>© 2026 Beauty Parlour Appointment System</p>

<p>Beauty • Style • Care</p>

</footer>

</body>
</html>
