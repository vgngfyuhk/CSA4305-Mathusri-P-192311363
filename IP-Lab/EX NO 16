<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>TechSavvy Online Shopping</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f7fb;
    color:#222;
}

header{
    background:#172554;
    color:white;
    padding:25px;
    text-align:center;
}

nav{
    background:#0f172a;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
}

nav a{
    color:white;
    text-decoration:none;
    padding:14px 18px;
}

nav a:hover{
    background:#2563eb;
}

.hero{
    background:#dbeafe;
    text-align:center;
    padding:45px 20px;
}

.hero h2{
    color:#1d4ed8;
    margin-bottom:10px;
}

.container{
    width:90%;
    max-width:1150px;
    margin:auto;
}

section{
    background:white;
    margin:22px 0;
    padding:22px;
    border-radius:10px;
    box-shadow:0 2px 8px #ddd;
}

h2{
    color:#1d4ed8;
    margin-bottom:15px;
}

h3{
    color:#172554;
    margin:10px 0;
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

input,select,textarea{
    width:100%;
    padding:11px;
    border:1px solid #ccc;
    border-radius:5px;
    margin-top:5px;
    margin-bottom:12px;
}

button{
    background:#2563eb;
    color:white;
    border:0;
    padding:11px 18px;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:#1d4ed8;
}

.categories{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.category{
    background:#eff6ff;
    padding:20px;
    text-align:center;
    border-radius:8px;
    cursor:pointer;
}

.products{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.product{
    border:1px solid #ddd;
    border-radius:8px;
    padding:15px;
    text-align:center;
}

.product img{
    width:100%;
    height:170px;
    object-fit:cover;
    border-radius:6px;
}

.product h3{
    color:#1d4ed8;
}

.price{
    font-size:20px;
    font-weight:bold;
    margin:10px;
}

.cart-item{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:12px;
    border-bottom:1px solid #ddd;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    border:1px solid #ccc;
    padding:10px;
    text-align:center;
}

th{
    background:#2563eb;
    color:white;
}

footer{
    background:#0f172a;
    color:white;
    text-align:center;
    padding:20px;
    margin-top:20px;
}

@media(max-width:800px){

    .form-grid{
        grid-template-columns:1fr;
    }

    .categories{
        grid-template-columns:1fr 1fr;
    }

    .products{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:600px){

    nav{
        flex-direction:column;
        text-align:center;
    }

    .categories,
    .products{
        grid-template-columns:1fr;
    }

    .cart-item{
        flex-direction:column;
        gap:8px;
    }

    table{
        font-size:12px;
    }
}

</style>


<script>

var cart=[];
var total=0;


/* Login */

function login(){

    var email=document.getElementById("email").value;
    var password=document.getElementById("password").value;

    if(email=="" || password==""){
        alert("Enter email and password");
    }
    else{
        alert("Login Successful!");
    }

}


/* Register */

function register(){

    var name=document.getElementById("name").value;

    if(name==""){
        alert("Enter your name");
    }
    else{
        alert("Registration Successful!");
    }

}


/* Search */

function searchProduct(){

    var search=document.getElementById("search").value.toLowerCase();

    var products=document.getElementsByClassName("product");

    for(var i=0;i<products.length;i++){

        var text=products[i].innerText.toLowerCase();

        if(text.includes(search))
            products[i].style.display="block";
        else
            products[i].style.display="none";
    }

}


/* Add Cart */

function addCart(name,price){

    cart.push({
        name:name,
        price:price
    });

    total+=price;

    showCart();

    alert(name+" added to shopping cart");

}


/* Show Cart */

function showCart(){

    var list=document.getElementById("cartList");

    list.innerHTML="";

    for(var i=0;i<cart.length;i++){

        list.innerHTML+=
        "<div class='cart-item'>"+
        "<span>"+cart[i].name+
        " - ₹"+cart[i].price+"</span>"+
        "<button onclick='removeCart("+i+")'>Remove</button>"+
        "</div>";

    }

    document.getElementById("total").innerHTML=
    "Total: ₹"+total;

}


/* Remove Cart */

function removeCart(index){

    total-=cart[index].price;

    cart.splice(index,1);

    showCart();

}


/* Checkout */

function checkout(){

    if(cart.length==0){

        alert("Shopping cart is empty");

        return;
    }

    var order=
    "TS"+Math.floor(100000+Math.random()*900000);

    document.getElementById("orderId").innerHTML=order;

    alert(
        "Order placed successfully!\n"+
        "Order ID: "+order+
        "\nAmount: ₹"+total
    );

}


/* Order Status */

function orderStatus(){

    var id=document.getElementById("orderSearch").value;

    if(id==""){

        alert("Enter Order ID");

    }
    else{

        document.getElementById("status").innerHTML=
        "Order "+id+" : Shipped";

    }

}


/* Product Details */

function details(name){

    alert(
        name+
        "\n\nAvailable for online purchase."+
        "\nFree delivery available."
    );

}


/* Admin Login */

function adminLogin(){

    alert("Admin Login Successful!");

}


/* Admin Add Product */

function addProduct(){

    var name=document.getElementById("newProduct").value;
    var price=document.getElementById("newPrice").value;

    if(name=="" || price==""){

        alert("Enter product details");

    }
    else{

        alert(
            "Product added successfully!\n"+
            name+" - ₹"+price
        );

    }

}


/* Payment */

function payment(){

    if(total==0){

        alert("No products in cart");

    }
    else{

        alert(
            "Payment Successful!\n"+
            "Amount Paid: ₹"+total
        );

    }

}


/* Logout */

function logout(){

    alert("Logged out successfully!");

}

</script>

</head>


<body>


